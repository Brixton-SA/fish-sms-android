<?xml version="1.0" encoding="utf-8"?>
<!-- Logo oficial de Fish (client/public/icon-512.png de fish-system) sobre una
     tarjeta blanca redondeada, para que se lea sobre el fondo oscuro.
     Regla de marca: NUNCA dibujar un pez ni otro ícono propio; siempre el logo de Fish. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:drawable="@drawable/fish_logo_mark"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp" />
</layer-list>
